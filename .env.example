VITE_API_URL=http://localhost:3001

# Production hosts commonly provide PORT automatically.
PORT=3001
API_PORT=3001
# Use comma-separated URLs if you need local and production frontends.
CORS_ORIGIN=http://localhost:5173

# Supabase database connection string.
# Use the Session pooler connection string from Supabase for a persistent Node server.
DATABASE_URL=test

# Optional: choose the cloud AI provider for fallback stranger replies.
# auto prefers Hugging Face when HF_TOKEN exists, then OpenAI, then local rules.
ASSISTANT_PROVIDER=auto

# Optional: Hugging Face Inference Providers chat completion.
# Create a read/inference token in Hugging Face settings and keep it backend-only.
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_BASE_URL=https://router.huggingface.co/v1

# Optional: OpenAI-powered fallback stranger replies.
# Without a cloud key, the app uses the local fallback reply rules.
OPENAI_API_KEY= 
OPENAI_MODEL=gpt-4.1-mini
# Optional: 0.35 means 35% local replies even when OpenAI is working.
LOCAL_ASSISTANT_REPLY_CHANCE=0

# Optional but strongly recommended for production video calls across different networks.
# Metered.ca dynamic TURN credentials. Keep the secret key backend-only.
METERED_DOMAIN=
METERED_SECRET_KEY=

# Static TURN fallback if you do not use Metered dynamic credentials.
# TURN_URLS can contain comma-separated URLs, for example:
# TURN_URLS=turn:your-turn-host.com:3478,turns:your-turn-host.com:5349
METERED_DOMAIN=
METERED_SECRET_KEY=